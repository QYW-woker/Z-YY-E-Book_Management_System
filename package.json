{
  "name": "ebook-admin-system",
  "version": "1.0.0",
  "description": "电子书后台管理系统",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "reader-app"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:reader\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:reader": "npm run dev --workspace=reader-app",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:reader": "npm run build --workspace=reader-app",
    "start": "npm run start --workspace=backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:reader": "cd reader-app && npm install",
    "postinstall": "node scripts/copy-deps.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
