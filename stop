#!/bin/bash

# 电子书后台管理系统 - 停止脚本
# 用法: ./stop

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
PID_DIR="$PROJECT_DIR/.pids"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 停止进程
stop_process() {
    local name=$1
    local pid_file="$PID_DIR/$name.pid"

    if [ -f "$pid_file" ]; then
        PID=$(cat "$pid_file")
        if kill -0 "$PID" 2>/dev/null; then
            log_info "正在停止 $name 服务 (PID: $PID)..."
            kill "$PID" 2>/dev/null

            # 等待进程退出
            local count=0
            while kill -0 "$PID" 2>/dev/null && [ $count -lt 10 ]; do
                sleep 0.5
                count=$((count + 1))
            done

            # 如果还没退出，强制杀死
            if kill -0 "$PID" 2>/dev/null; then
                log_warn "$name 服务未正常退出，强制终止..."
                kill -9 "$PID" 2>/dev/null || true
            fi

            log_info "$name 服务已停止"
        else
            log_warn "$name 服务未运行 (PID文件存在但进程不存在)"
        fi
        rm -f "$pid_file"
    else
        log_warn "$name 服务未运行 (无PID文件)"
    fi
}

# 清理可能残留的进程
cleanup_orphan_processes() {
    # 查找并杀死可能残留的 vite 和 tsx 进程
    local vite_pids=$(pgrep -f "vite.*--port 3000" 2>/dev/null || true)
    local tsx_pids=$(pgrep -f "tsx.*backend/src" 2>/dev/null || true)

    if [ -n "$vite_pids" ]; then
        log_info "清理残留的前端进程..."
        echo "$vite_pids" | xargs kill 2>/dev/null || true
    fi

    if [ -n "$tsx_pids" ]; then
        log_info "清理残留的后端进程..."
        echo "$tsx_pids" | xargs kill 2>/dev/null || true
    fi
}

# 主流程
main() {
    echo ""
    echo "=========================================="
    echo "   电子书后台管理系统 - 停止服务"
    echo "=========================================="
    echo ""

    stop_process "backend"
    stop_process "frontend"
    cleanup_orphan_processes

    echo ""
    log_info "所有服务已停止"
    echo ""
    echo "  重新启动: ./restart"
    echo "=========================================="
    echo ""
}

main
