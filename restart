#!/bin/bash

# 电子书后台管理系统 - 启动/重启脚本
# 用法: ./restart

set -e

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
PID_DIR="$PROJECT_DIR/.pids"
LOG_DIR="$PROJECT_DIR/logs"

# 创建必要目录
mkdir -p "$PID_DIR" "$LOG_DIR"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 停止已运行的服务
stop_services() {
    log_info "正在停止已运行的服务..."

    # 停止后端
    if [ -f "$PID_DIR/backend.pid" ]; then
        BACKEND_PID=$(cat "$PID_DIR/backend.pid")
        if kill -0 "$BACKEND_PID" 2>/dev/null; then
            kill "$BACKEND_PID" 2>/dev/null || true
            log_info "后端服务已停止 (PID: $BACKEND_PID)"
        fi
        rm -f "$PID_DIR/backend.pid"
    fi

    # 停止前端
    if [ -f "$PID_DIR/frontend.pid" ]; then
        FRONTEND_PID=$(cat "$PID_DIR/frontend.pid")
        if kill -0 "$FRONTEND_PID" 2>/dev/null; then
            kill "$FRONTEND_PID" 2>/dev/null || true
            log_info "前端服务已停止 (PID: $FRONTEND_PID)"
        fi
        rm -f "$PID_DIR/frontend.pid"
    fi

    # 等待进程完全退出
    sleep 1
}

# 检查依赖
check_dependencies() {
    log_info "检查依赖..."

    if ! command -v node &> /dev/null; then
        log_error "未找到 Node.js，请先安装"
        exit 1
    fi

    if ! command -v npm &> /dev/null; then
        log_error "未找到 npm，请先安装"
        exit 1
    fi

    log_info "Node.js 版本: $(node -v)"
}

# 安装依赖
install_dependencies() {
    log_info "检查并安装依赖..."

    # 根目录依赖
    if [ ! -d "$PROJECT_DIR/node_modules" ]; then
        log_info "安装根目录依赖..."
        cd "$PROJECT_DIR" && npm install
    fi

    # 前端依赖
    if [ ! -d "$PROJECT_DIR/frontend/node_modules" ]; then
        log_info "安装前端依赖..."
        cd "$PROJECT_DIR/frontend" && npm install
    fi

    # 后端依赖
    if [ ! -d "$PROJECT_DIR/backend/node_modules" ]; then
        log_info "安装后端依赖..."
        cd "$PROJECT_DIR/backend" && npm install
    fi
}

# 初始化后端环境
init_backend_env() {
    if [ ! -f "$PROJECT_DIR/backend/.env" ]; then
        log_info "创建后端环境配置文件..."
        cp "$PROJECT_DIR/backend/.env.example" "$PROJECT_DIR/backend/.env"
    fi
}

# 启动后端
start_backend() {
    log_info "启动后端服务..."

    cd "$PROJECT_DIR/backend"

    # 后台运行并记录PID
    nohup npm run dev > "$LOG_DIR/backend.log" 2>&1 &
    BACKEND_PID=$!
    echo $BACKEND_PID > "$PID_DIR/backend.pid"

    # 等待启动
    sleep 2

    if kill -0 "$BACKEND_PID" 2>/dev/null; then
        log_info "后端服务启动成功 (PID: $BACKEND_PID)"
        log_info "后端地址: http://localhost:3001"
        log_info "日志文件: $LOG_DIR/backend.log"
    else
        log_error "后端服务启动失败，请查看日志: $LOG_DIR/backend.log"
        exit 1
    fi
}

# 启动前端
start_frontend() {
    log_info "启动前端服务..."

    cd "$PROJECT_DIR/frontend"

    # 后台运行并记录PID
    nohup npm run dev > "$LOG_DIR/frontend.log" 2>&1 &
    FRONTEND_PID=$!
    echo $FRONTEND_PID > "$PID_DIR/frontend.pid"

    # 等待启动
    sleep 3

    if kill -0 "$FRONTEND_PID" 2>/dev/null; then
        log_info "前端服务启动成功 (PID: $FRONTEND_PID)"
        log_info "前端地址: http://localhost:3000"
        log_info "日志文件: $LOG_DIR/frontend.log"
    else
        log_error "前端服务启动失败，请查看日志: $LOG_DIR/frontend.log"
        exit 1
    fi
}

# 主流程
main() {
    echo ""
    echo "=========================================="
    echo "   电子书后台管理系统 - 启动/重启"
    echo "=========================================="
    echo ""

    stop_services
    check_dependencies
    install_dependencies
    init_backend_env
    start_backend
    start_frontend

    echo ""
    echo "=========================================="
    log_info "所有服务启动完成!"
    echo ""
    echo "  前端地址: http://localhost:3000"
    echo "  后端地址: http://localhost:3001"
    echo "  默认账号: admin / admin123"
    echo ""
    echo "  查看日志:"
    echo "    tail -f $LOG_DIR/frontend.log"
    echo "    tail -f $LOG_DIR/backend.log"
    echo ""
    echo "  停止服务: ./stop"
    echo "=========================================="
    echo ""
}

main
